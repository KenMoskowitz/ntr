---
interface Props {
  headline: string
  subhead?: string
}
const {headline, subhead} = Astro.props
---

<section class="hero">
  <div class="hero-inner">
    <h1>{headline}</h1>
    {subhead && <p class="subhead">{subhead}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 3rem;
    text-align: center;
  }
  .subhead {
    white-space: pre-line;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
