---
import {urlFor} from '../lib/sanity'

interface Props {
  navigation?: {footerLinks?: {label: string; href: string}[]} | null
  siteSettings?: {legalName?: string; foundedYear?: number; facebookUrl?: string; instagramUrl?: string; linkedinUrl?: string; mascot?: any} | null
}
const {navigation, siteSettings} = Astro.props

const links = navigation?.footerLinks?.length
  ? navigation.footerLinks
  : [
      {label: 'Home', href: '/'},
      {label: 'About', href: '/about'},
      {label: 'Services', href: '/services'},
      {label: 'Careers', href: '/careers'},
      {label: 'Contact', href: '/contact'},
      {label: 'Privacy Policy', href: '/privacy-policy'},
    ]

const legalName = siteSettings?.legalName || 'National TeleTherapy Resources'
const year = new Date().getFullYear()
const mascotUrl = siteSettings?.mascot ? urlFor(siteSettings.mascot).width(120).url() : null
---

<footer class="site-footer">
  <div class="inner">
    {mascotUrl ? (
      <img class="mascot" src={mascotUrl} alt="Link the Elephant, NTR Link mascot" width="80" height="94" />
    ) : (
      <span class="mascot-mark" role="img" aria-label="Link the Elephant, NTR Link mascot">🐘</span>
    )}
    <nav>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="social">
      {siteSettings?.facebookUrl && <a href={siteSettings.facebookUrl}>Facebook</a>}
      {siteSettings?.instagramUrl && <a href={siteSettings.instagramUrl}>Instagram</a>}
      {siteSettings?.linkedinUrl && <a href={siteSettings.linkedinUrl}>LinkedIn</a>}
    </div>
    <p class="copyright">{legalName} &reg; All rights reserved &mdash; {year}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    margin-top: 4rem;
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    text-align: center;
  }
  .mascot-mark {
    display: block;
    font-size: 3.5rem;
    margin: 0 auto 1rem;
    line-height: 1;
  }
  .mascot {
    margin: 0 auto 1rem;
  }
  nav ul {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    text-decoration: none;
    color: var(--color-footer-text);
    font-weight: 500;
    opacity: 0.9;
  }
  nav a:hover {
    opacity: 1;
    color: var(--color-accent);
  }
  .social {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .social a {
    color: var(--color-footer-text);
    opacity: 0.75;
    font-size: 0.9rem;
  }
  .social a:hover {
    opacity: 1;
  }
  .copyright {
    font-size: 0.82rem;
    opacity: 0.6;
    margin: 0;
  }
</style>
