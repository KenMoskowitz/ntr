---
interface Props {
  navigation?: {footerLinks?: {label: string; href: string}[]} | null
  siteSettings?: {legalName?: string; foundedYear?: number; facebookUrl?: string; instagramUrl?: string; linkedinUrl?: string} | null
}
const {navigation, siteSettings} = Astro.props

const links = navigation?.footerLinks?.length
  ? navigation.footerLinks
  : [
      {label: 'Home', href: '/'},
      {label: 'About', href: '/about'},
      {label: 'Services', href: '/services'},
      {label: 'Careers', href: '/careers'},
      {label: 'Contact', href: '/contact'},
      {label: 'Privacy Policy', href: '/privacy-policy'},
    ]

const legalName = siteSettings?.legalName || 'National TeleTherapy Resources'
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <img class="mascot" src="/images/elephant-footer.png" alt="Link the Elephant, NTR Link mascot" width="127" height="150" />
  <nav>
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="social">
    {siteSettings?.facebookUrl && <a href={siteSettings.facebookUrl}>Facebook</a>}
    {siteSettings?.instagramUrl && <a href={siteSettings.instagramUrl}>Instagram</a>}
    {siteSettings?.linkedinUrl && <a href={siteSettings.linkedinUrl}>LinkedIn</a>}
  </div>
  <p class="copyright">{legalName} &reg; All rights reserved &mdash; {year}.</p>
</footer>

<style>
  .site-footer {
    padding: 2rem;
    text-align: center;
  }
  .mascot {
    display: block;
    margin: 0 auto 1rem;
  }
  nav ul {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a,
  .social a {
    text-decoration: none;
    color: inherit;
  }
  .social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .copyright {
    font-size: 0.85rem;
    opacity: 0.8;
  }
</style>
