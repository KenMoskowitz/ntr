---
interface Props {
  quote: string
  attributionName?: string
  attributionRole?: string
  attributionDistrict?: string
  delay?: number
}
const {quote, attributionName, attributionRole, attributionDistrict, delay = 0} = Astro.props
const attribution = [attributionName, attributionRole, attributionDistrict].filter(Boolean).join(', ')
---

<blockquote class="testimonial dz-reveal" style={`--dz-delay: ${delay}s`}>
  <p>&ldquo;{quote}&rdquo;</p>
  {attribution && <footer>&mdash; {attribution}</footer>}
</blockquote>

<style>
  .testimonial {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem 1.75rem;
    margin: 1.25rem 0;
  }
  .testimonial p {
    margin: 0;
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-text);
  }
  footer {
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-style: normal;
  }
</style>
