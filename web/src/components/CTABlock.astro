---
interface Props {
  buttons?: {label: string; href: string}[]
}
const {buttons} = Astro.props
const ctas = buttons?.length
  ? buttons
  : [
      {label: 'Work with us', href: '/contact'},
      {label: 'Work for us', href: '/careers'},
    ]
---

<div class="cta-block">
  {ctas.map((cta) => (
    <a class="cta-button" href={cta.href}>{cta.label}</a>
  ))}
</div>

<style>
  .cta-block {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem 0;
  }
  .cta-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 0.25rem;
    background: #1a1a1a;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
</style>
