---
interface Props {
  buttons?: {label: string; href: string}[]
}
const {buttons} = Astro.props
const ctas = buttons?.length
  ? buttons
  : [
      {label: 'Work with us', href: '/contact'},
      {label: 'Work for us', href: '/careers'},
    ]
---

<div class="cta-block">
  {ctas.map((cta, i) => (
    <a class={`cta-button ${i === 0 ? 'primary dz-trail-dark' : 'secondary'}`} href={cta.href}>{cta.label}</a>
  ))}
</div>

<style>
  .cta-block {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem 0;
    padding: 0 1.5rem;
  }
  .cta-button {
    display: inline-block;
    padding: 0.85rem 1.85rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
    transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .cta-button.primary {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    box-shadow:
      0 2px 4px rgba(11, 91, 84, 0.15),
      0 10px 24px rgba(11, 91, 84, 0.28);
  }
  .cta-button.primary:hover {
    box-shadow:
      0 4px 8px rgba(11, 91, 84, 0.2),
      0 16px 36px rgba(11, 91, 84, 0.35);
    transform: translateY(-2px);
  }
  .cta-button.secondary {
    background: var(--color-surface);
    color: var(--color-primary-dark);
    border: 1.5px solid var(--color-primary);
  }
  .cta-button.secondary:hover {
    background: var(--color-primary-light);
    transform: translateY(-1px);
  }
</style>
