---
interface Props {
  title: string
  state: string
  employmentType?: string
  description?: string
  datePosted?: string
  validThrough?: string
}
const {title, state, employmentType, description, datePosted, validThrough} = Astro.props

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title,
  datePosted,
  validThrough,
  employmentType: employmentType ? [employmentType] : ['PART_TIME', 'FULL_TIME'],
  hiringOrganization: {'@type': 'Organization', name: 'National TeleTherapy Resources'},
  jobLocationType: 'TELECOMMUTE',
  applicantLocationRequirements: {'@type': 'Country', name: 'USA'},
}
---

<article class="job-card">
  <div class="job-card-head">
    <h3>{title}</h3>
    <span class="state-badge">{state}</span>
  </div>
  {description && <p>{description}</p>}
  <a class="apply-link" href="/contact">Apply &rarr;</a>
</article>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .job-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem;
    margin: 1rem 0;
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .job-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .job-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .job-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .state-badge {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .job-card p {
    color: var(--color-text-muted);
  }
  .apply-link {
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
