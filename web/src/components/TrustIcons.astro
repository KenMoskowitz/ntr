---
interface Props {
  items?: string[]
}
const {items} = Astro.props
const bullets = items?.length
  ? items
  : ['Therapist owned and operated', 'One point of contact, not a call center', 'State and nationally licensed providers']
---

<ul class="trust-icons section">
  {bullets.map((item, i) => (
    <li class="dz-reveal" style={`--dz-delay: ${i * 0.1}s`}><span class="dot">✓</span>{item}</li>
  ))}
</ul>

<style>
  .trust-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    list-style: none;
    padding: 0 1.5rem;
    margin: -1rem auto 0;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .dot {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
