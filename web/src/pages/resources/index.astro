---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import {sanityFetch} from '../../lib/sanity'

const cms = await sanityFetch(`*[_type == "page" && pageId == "resources-index"][0]`)
const posts =
  (await sanityFetch(
    `*[_type == "resourcePost"] | order(publishDate desc){title, slug, metaDescription, publishDate}`,
  )) || []

const title = cms?.metaTitle || 'Resources | NTR Link'
const description =
  cms?.metaDescription ||
  'Guides on teletherapy, IEP compliance, and Medicaid billing for special education administrators.'
const heroHeadline = cms?.heroHeadline || 'Answers for the Research Before the Call'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://ntrlink.com/'},
      {'@type': 'ListItem', position: 2, name: 'Resources', item: 'https://ntrlink.com/resources'},
    ],
  },
]
---

<BaseLayout title={title} description={description} canonicalUrl="https://ntrlink.com/resources" jsonLd={jsonLd}>
  <Hero headline={heroHeadline} />
  <section class="post-list section">
    {posts.length > 0 ? (
      posts.map((post, i) => (
        <a class="post-card dz-lift dz-reveal" style={`--dz-delay: ${i * 0.1}s`} href={`/resources/${post.slug.current}`}>
          <h2>{post.title}</h2>
          <p>{post.metaDescription}</p>
        </a>
      ))
    ) : (
      <p class="pending-note">Articles are on the way &mdash; add them in Sanity under Resource Posts.</p>
    )}
  </section>
</BaseLayout>

<style>
  .post-list {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
  }
  .pending-note {
    text-align: center;
    color: var(--color-text-muted);
    font-style: italic;
  }
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem;
  }
  .post-card p {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
