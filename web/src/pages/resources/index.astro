---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import {sanityFetch} from '../../lib/sanity'

const cms = await sanityFetch(`*[_type == "page" && pageId == "resources-index"][0]`)
const posts =
  (await sanityFetch(
    `*[_type == "resourcePost"] | order(publishDate desc){title, slug, metaDescription, publishDate}`,
  )) || []

const title = cms?.metaTitle || 'Resources | NTR Link'
const description =
  cms?.metaDescription ||
  'Guides on teletherapy, IEP compliance, and Medicaid billing for special education administrators.'
const heroHeadline = cms?.heroHeadline || 'Answers for the Research Before the Call'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://ntrlink.com/'},
      {'@type': 'ListItem', position: 2, name: 'Resources', item: 'https://ntrlink.com/resources'},
    ],
  },
]
---

<BaseLayout title={title} description={description} canonicalUrl="https://ntrlink.com/resources" jsonLd={jsonLd}>
  <Hero headline={heroHeadline} />
  <section class="post-list section">
    {posts.map((post) => (
      <a class="post-card" href={`/resources/${post.slug.current}`}>
        <h2>{post.title}</h2>
        <p>{post.metaDescription}</p>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .post-list {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
  }
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem;
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .post-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .post-card p {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
