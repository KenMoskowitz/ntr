---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import {sanityFetch} from '../../lib/sanity'

const cms = await sanityFetch(`*[_type == "page" && pageId == "services-index"][0]`)

const title = cms?.metaTitle || 'Our Services | NTR Link Virtual School Therapy'
const description =
  cms?.metaDescription ||
  "Explore NTR Link's virtual speech-language and occupational therapy programs built for public school districts."
const heroHeadline = cms?.heroHeadline || 'Two Services. One Team. Zero Guesswork.'
const heroSubhead =
  cms?.heroSubhead ||
  "Two ways we show up for your students: Speech-Language Therapy and Occupational Therapy, both delivered virtually, both built around your district's actual schedule."

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://ntrlink.com/'},
      {'@type': 'ListItem', position: 2, name: 'Services', item: 'https://ntrlink.com/services'},
    ],
  },
]
---

<BaseLayout title={title} description={description} canonicalUrl="https://ntrlink.com/services" jsonLd={jsonLd}>
  <Hero headline={heroHeadline} subhead={heroSubhead} />
  <section class="service-cards section">
    <a class="service-card dz-lift dz-reveal" style="--dz-delay: 0s" href="/speech-therapy">
      <h2>Speech-Language Therapy</h2>
      <p>Language, articulation, fluency, social communication, AAC.</p>
      <span class="card-link dz-underline">Learn more &rarr;</span>
    </a>
    <a class="service-card dz-lift dz-reveal" style="--dz-delay: 0.12s" href="/occupational-therapy">
      <h2>Occupational Therapy</h2>
      <p>Fine motor, visual-motor integration, sensory processing, executive functioning.</p>
      <span class="card-link dz-underline">Learn more &rarr;</span>
    </a>
  </section>
  <section class="implementation section section-alt">
    <h2>Simple Implementation Process<span class="header-draw dz-draw"></span></h2>
    <ol>
      <li>We match your district with licensed therapists in your state.</li>
      <li>A dedicated program coordinator sets up scheduling around your school calendar.</li>
      <li>Therapists deliver sessions virtually, with on-site staff trained as facilitators.</li>
      <li>Progress reports tie back to IEP goals so your team always has current documentation.</li>
    </ol>
  </section>
</BaseLayout>

<style>
  .service-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    max-width: 50rem;
  }
  .service-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
  }
  .service-card p {
    color: var(--color-text-muted);
  }
  .card-link {
    display: inline-block;
    font-weight: 600;
    color: var(--color-primary);
    font-family: var(--font-heading);
    padding: 2px 0;
  }
  .implementation {
    max-width: 40rem;
  }
  .implementation h2 {
    display: inline-block;
  }
  .header-draw {
    display: block;
    width: 3.5rem;
    height: 3px;
    background: var(--color-accent);
    border-radius: 2px;
    margin-top: 0.4rem;
  }
  .implementation li {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }
</style>
