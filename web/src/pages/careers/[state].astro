---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import JobCard from '../../components/JobCard.astro'
import {sanityFetch} from '../../lib/sanity'

// NOTE: fallback data must live INSIDE getStaticPaths, not at module top
// level — see services/[state].astro for why (Astro build-time repro).
export async function getStaticPaths() {
  const FALLBACK_STATES = [
    {
      stateName: 'California',
      slug: {current: 'california'},
      metaTitle: 'California Speech & OT Jobs | Remote | NTR Link',
      metaDescription:
        'Licensed in California? NTR Link is hiring remote speech-language pathologists and occupational therapists for public schools.',
      licenseNote:
        'Requires active California licensure (SLP: California Speech-Language Pathology and Audiology and Hearing Aid Dispensers Board; OT: California Board of Occupational Therapy).',
      openRoles: [],
    },
    {
      stateName: 'Tennessee',
      slug: {current: 'tennessee'},
      metaTitle: 'Tennessee Speech & OT Jobs | Remote | NTR Link',
      metaDescription:
        'Licensed in Tennessee? NTR Link is hiring remote speech-language pathologists and occupational therapists for public schools.',
      licenseNote: 'Requires active Tennessee licensure (SLP/Audiology Licensing Board; OT: Board of Occupational Therapy).',
      openRoles: [],
    },
  ]

  const pages = (await sanityFetch(`*[_type == "stateJobPage"]{..., openRoles[]->}`)) || FALLBACK_STATES
  return pages.map((page) => ({
    params: {state: page.slug.current},
    props: {page},
  }))
}

const {page} = Astro.props as {page: any}
const canonicalUrl = `https://ntrlink.com/careers/${page.slug.current}`

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://ntrlink.com/'},
      {'@type': 'ListItem', position: 2, name: 'Careers', item: 'https://ntrlink.com/careers'},
      {'@type': 'ListItem', position: 3, name: page.stateName, item: canonicalUrl},
    ],
  },
]
---

<BaseLayout title={page.metaTitle} description={page.metaDescription} canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <Hero headline={`${page.stateName} Licensed? We're Hiring.`} subhead={page.intro} />
  {page.licenseNote && (
    <p class="license-note section">{page.licenseNote}</p>
  )}
  <section class="job-list section">
    {page.openRoles?.length > 0 ? (
      page.openRoles.map((job: any) => (
        <JobCard
          title={job.title}
          state={job.state}
          employmentType={job.employmentType}
          description={job.description}
          datePosted={job.datePosted}
          validThrough={job.validThrough}
        />
      ))
    ) : (
      <p class="pending-note">No open roles posted for {page.stateName} right now — check back soon.</p>
    )}
  </section>
  <p class="difference-note section">
    NTR Link isn't a staffing agency ticket queue: one point of contact, a therapist-run culture, and real onboarding
    before your first session.
  </p>
</BaseLayout>

<style>
  .license-note {
    max-width: 40rem;
    padding-top: 0;
    padding-bottom: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .job-list {
    max-width: 40rem;
    padding-top: 0;
  }
  .pending-note {
    color: var(--color-text-muted);
    font-style: italic;
  }
  .difference-note {
    max-width: 40rem;
    padding-top: 0;
    color: var(--color-text-muted);
  }
</style>
