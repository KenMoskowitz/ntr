---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import {sanityFetch} from '../lib/sanity'

const cms = await sanityFetch(`*[_type == "page" && pageId == "contact"][0]`)

const title = cms?.metaTitle || 'Contact NTR Link | Request Services or Apply'
const description =
  cms?.metaDescription ||
  'Reach NTR Link to request teletherapy services for your school district or to apply for a virtual SLP or OT position.'
const heroHeadline = cms?.heroHeadline || 'Two Doors In. Pick Yours.'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://ntrlink.com/'},
      {'@type': 'ListItem', position: 2, name: 'Contact', item: 'https://ntrlink.com/contact'},
    ],
  },
]
---

<BaseLayout title={title} description={description} canonicalUrl="https://ntrlink.com/contact" jsonLd={jsonLd}>
  <Hero headline={heroHeadline} />

  <div class="toggle" role="tablist">
    <button type="button" class="toggle-btn active" data-target="district">Request Services</button>
    <button type="button" class="toggle-btn" data-target="candidate">Apply for a Job</button>
  </div>

  <form id="contact-form" class="contact-form">
    <input type="hidden" name="submissionType" value="district" />
    <!-- honeypot, hidden from real users via CSS -->
    <label class="hp"><input type="text" name="website" tabindex="-1" autocomplete="off" /></label>

    <label>Name <input type="text" name="name" required /></label>
    <label>Email <input type="email" name="email" required /></label>
    <label>Phone <input type="tel" name="phone" /></label>
    <label data-field="state">State <input type="text" name="state" placeholder="e.g. California" /></label>
    <label data-field="message-district">How can we help your district? <textarea name="message" rows="4"></textarea></label>
    <label data-field="message-candidate" hidden>Tell us about your license and availability <textarea name="message" rows="4"></textarea></label>

    <button type="submit" class="dz-trail-dark">Send</button>
    <p class="form-status" role="status"></p>
  </form>
</BaseLayout>

<style>
  .toggle {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 auto 2rem;
    padding: 0 1.5rem;
  }
  .toggle-btn {
    padding: 0.65rem 1.4rem;
    border: 1.5px solid var(--color-primary);
    background: var(--color-surface);
    color: var(--color-primary-dark);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-heading);
    transition: background 0.15s, color 0.15s;
  }
  .toggle-btn.active {
    background: var(--color-primary);
    color: #fff;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 30rem;
    margin: 0 auto 4rem;
    padding: 2rem 2.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .contact-form label[hidden] {
    display: none;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-text);
  }
  .contact-form input,
  .contact-form textarea {
    font: inherit;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }
  .contact-form button[type='submit'] {
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    border: none;
    font-weight: 700;
    font-family: var(--font-heading);
    font-size: 1rem;
    cursor: pointer;
    box-shadow:
      0 2px 4px rgba(11, 91, 84, 0.15),
      0 10px 24px rgba(11, 91, 84, 0.28);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .contact-form button[type='submit']:hover {
    transform: translateY(-2px);
    box-shadow:
      0 4px 8px rgba(11, 91, 84, 0.2),
      0 16px 36px rgba(11, 91, 84, 0.35);
  }
  .form-status {
    min-height: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>('.toggle-btn')
  const typeInput = form.querySelector<HTMLInputElement>('input[name="submissionType"]')!
  const stateField = form.querySelector<HTMLElement>('[data-field="state"]')!
  const districtMessage = form.querySelector<HTMLElement>('[data-field="message-district"]')!
  const candidateMessage = form.querySelector<HTMLElement>('[data-field="message-candidate"]')!
  const status = form.querySelector<HTMLElement>('.form-status')!

  toggleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      toggleButtons.forEach((b) => b.classList.remove('active'))
      btn.classList.add('active')
      const target = btn.dataset.target!
      typeInput.value = target

      const isDistrict = target === 'district'
      stateField.hidden = !isDistrict
      districtMessage.hidden = !isDistrict
      candidateMessage.hidden = isDistrict
      // Both message textareas share name="message"; disable the hidden one
      // so only the visible field's value gets submitted.
      districtMessage.querySelector('textarea')!.toggleAttribute('disabled', !isDistrict)
      candidateMessage.querySelector('textarea')!.toggleAttribute('disabled', isDistrict)
    })
  })
  // Candidate message starts disabled since district mode is the default.
  candidateMessage.querySelector('textarea')!.setAttribute('disabled', '')

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    status.textContent = 'Sending…'
    const formData = new FormData(form)
    const payload = Object.fromEntries(formData.entries())

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload),
      })
      if (!res.ok) throw new Error('request failed')
      status.textContent = "Thanks — we'll be in touch shortly."
      form.reset()
    } catch {
      status.textContent = 'Something went wrong. Please call 844-687-5465 or try again.'
    }
  })
</script>
