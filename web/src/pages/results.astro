---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import TestimonialCard from '../components/TestimonialCard.astro'
import {sanityFetch} from '../lib/sanity'

const cms = await sanityFetch(
  `*[_type == "page" && pageId == "results"][0]{..., stats[]->, testimonials[]->}`,
)

const title = cms?.metaTitle || 'Results | Student Outcomes with NTR Link'
const description =
  cms?.metaDescription ||
  "See the real numbers behind NTR Link's virtual therapy programs, from IEP goal progress to therapist retention."
const heroHeadline = cms?.heroHeadline || 'The Numbers Behind the Claim'
const stats = cms?.stats || []
const testimonials = cms?.testimonials || []

// Parses a free-text stat like "35+", "$2B+", "98%" into Count-Up's
// numeric/prefix/suffix attributes so the animation always lands on the
// exact string an editor typed in Sanity.
function parseStat(raw: string) {
  const match = String(raw).match(/^([^0-9.]*)([0-9.]+)(.*)$/)
  if (!match) return {prefix: '', number: '', suffix: raw}
  const [, prefix, number, suffix] = match
  return {prefix, number, suffix}
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://ntrlink.com/'},
      {'@type': 'ListItem', position: 2, name: 'Results', item: 'https://ntrlink.com/results'},
    ],
  },
]
---

<BaseLayout title={title} description={description} canonicalUrl="https://ntrlink.com/results" jsonLd={jsonLd}>
  <Hero headline={heroHeadline} />
  {stats.length > 0 ? (
    <section class="stats-grid section">
      {stats.map((stat: any, i: number) => {
        const {prefix, number, suffix} = parseStat(stat.statNumber)
        return (
          <div class="stat dz-reveal" style={`--dz-delay: ${i * 0.1}s`}>
            <p class="stat-number" data-dz-count={number || undefined} data-dz-prefix={prefix} data-dz-suffix={suffix}>
              {stat.statNumber}
            </p>
            <p class="stat-label">{stat.statLabel}</p>
          </div>
        )
      })}
    </section>
  ) : (
    <p class="pending-note section">
      We're building this page around real numbers &mdash; therapist retention, average time to fill an open
      position, districts served, IEP goal completion rates. Add them in Sanity under Outcome Stats as they're
      tracked.
    </p>
  )}
  <section class="testimonials section">
    {testimonials.map((t: any, i: number) => (
      <TestimonialCard
        quote={t.quote}
        attributionName={t.attributionName}
        attributionRole={t.attributionRole}
        attributionDistrict={t.attributionDistrict}
        delay={i * 0.1}
      />
    ))}
  </section>
  <p class="proof-links">
    See how this shows up in practice: <a class="dz-underline" href="/speech-therapy">Speech-Language Therapy</a> &middot;{' '}
    <a class="dz-underline" href="/occupational-therapy">Occupational Therapy</a>
  </p>
</BaseLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
    max-width: 50rem;
    text-align: center;
  }
  .stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem 1rem;
  }
  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
  }
  .stat-label {
    margin: 0;
    color: var(--color-text-muted);
  }
  .pending-note {
    max-width: 40rem;
    text-align: center;
    color: var(--color-text-muted);
    font-style: italic;
  }
  .testimonials {
    max-width: 40rem;
  }
  .proof-links {
    text-align: center;
    padding: 0 1.5rem 3rem;
  }
</style>
